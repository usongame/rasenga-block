# 使用 Ubuntu 作为基础镜像
FROM ubuntu:22.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_VERSION=16.20.2
ENV WINEDEBUG=-all

# 安装必要的依赖
RUN dpkg --add-architecture i386 && \
    apt-get update && \
    apt-get install -y \
        curl \
        wget \
        git \
        python3 \
        python3-pip \
        make \
        g++ \
        gcc \
        libc6-dev \
        libgtk-3-dev \
        libnotify-dev \
        libnss3 \
        libxss1 \
        libasound2 \
        libxtst6 \
        xauth \
        xvfb \
        wine64 \
        wine32 \
        winetricks \
        && rm -rf /var/lib/apt/lists/*

# 安装 Node.js
RUN curl -fsSL https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz | \
    tar -xJf - -C /usr/local --strip-components=1

# 配置 Wine
ENV WINEARCH=win64
ENV WINEPREFIX=/root/.wine
RUN winecfg || true

# 设置工作目录
WORKDIR /app

# 复制项目文件
COPY . .

# 安装依赖并构建
RUN npm ci

# 构建 Windows 版本
CMD ["npm", "run", "dist:win"]
